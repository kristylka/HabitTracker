<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HabitTracker.Desktop.ViewModels"
             x:Class="HabitTracker.Desktop.Views.CalendarView"
             x:CompileBindings="False">

    <ScrollViewer>
        <StackPanel Margin="32,24" Spacing="20">

            <Border Background="White" CornerRadius="12" Padding="20">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="+ Привычка"
                            Background="#4CAF50"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="16,8"
                            FontWeight="SemiBold"
                            Command="{Binding ShowAddHabitCommand}"
                            VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="◀"
                                Background="Transparent"
                                FontSize="18"
                                Command="{Binding PreviousDayCommand}"/>
                        <Button Content="Сегодня"
                                Background="Transparent"
                                Foreground="#2E7D32"
                                FontWeight="SemiBold"
                                Command="{Binding GoToTodayCommand}"/>
                        <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dd MMMM yyyy, dddd}'}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="▶"
                                Background="Transparent"
                                FontSize="18"
                                Command="{Binding NextDayCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="20"
                    IsVisible="{Binding IsAddHabitVisible}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Новая привычка"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBox Watermark="Название (например: Выпить воды)"
                             Text="{Binding NewHabitName}"
                             CornerRadius="8"
                             Padding="12,10"/>

                    <TextBox Watermark="Описание (необязательно)"
                             Text="{Binding NewHabitDescription}"
                             CornerRadius="8"
                             Padding="12,10"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Время:" FontWeight="SemiBold"/>
                        <TimePicker SelectedTime="{Binding NewHabitTime}"
                                    MinuteIncrement="5"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Дни недели:" FontWeight="SemiBold"/>
                        <WrapPanel>
                            <CheckBox Content="Пн" IsChecked="{Binding Monday}" Margin="0,0,8,4"/>
                            <CheckBox Content="Вт" IsChecked="{Binding Tuesday}" Margin="0,0,8,4"/>
                            <CheckBox Content="Ср" IsChecked="{Binding Wednesday}" Margin="0,0,8,4"/>
                            <CheckBox Content="Чт" IsChecked="{Binding Thursday}" Margin="0,0,8,4"/>
                            <CheckBox Content="Пт" IsChecked="{Binding Friday}" Margin="0,0,8,4"/>
                            <CheckBox Content="Сб" IsChecked="{Binding Saturday}" Margin="0,0,8,4"/>
                            <CheckBox Content="Вс" IsChecked="{Binding Sunday}" Margin="0,0,8,4"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Добавить"
                                Background="#4CAF50"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="16,8"
                                Command="{Binding AddHabitCommand}"/>
                        <Button Content="Отмена"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="16,8"
                                Command="{Binding ShowAddHabitCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Задачи на день"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,4"
                                        Background="#FAFAFA">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                Text="{Binding ScheduledTime, StringFormat='{}{0:hh\\:mm}'}"
                                                FontWeight="SemiBold"
                                                Foreground="#2E7D32"
                                                VerticalAlignment="Center"/>

                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                Command="{Binding $parent[ItemsControl].DataContext.ToggleEntryCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Habit.Name}"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"/>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Мои привычки"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <ItemsControl ItemsSource="{Binding Habits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,3"
                                        Background="#FAFAFA">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Удалить"
                                                Background="#f44336"
                                                Foreground="White"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                FontSize="12"
                                                Command="{Binding $parent[ItemsControl].DataContext.DeleteHabitCommand}"
                                                CommandParameter="{Binding}"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10"
                                                    VerticalAlignment="Center">
                                            <Border Width="10"
                                                    Height="10"
                                                    CornerRadius="5"
                                                    Background="{Binding Color}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="Gray"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>