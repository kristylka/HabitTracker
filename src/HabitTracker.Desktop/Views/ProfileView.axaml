<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HabitTracker.Desktop.ViewModels"
             x:Class="HabitTracker.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel"
             x:CompileBindings="False">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="40" Width="420">
            <StackPanel Spacing="24">
                <TextBlock Text="👤"
                           FontSize="64"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding DisplayName}"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <Border Background="#F5F5F5" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <DockPanel>
                            <TextBlock Text="Логин"
                                       FontWeight="SemiBold"
                                       Foreground="Gray"
                                       Width="140"/>
                            <TextBlock Text="{Binding Username}"
                                       FontSize="14"/>
                        </DockPanel>

                        <Border Height="1" Background="#E0E0E0"/>

                        <DockPanel>
                            <TextBlock Text="Дата регистрации"
                                       FontWeight="SemiBold"
                                       Foreground="Gray"
                                       Width="140"/>
                            <TextBlock Text="{Binding MemberSince, StringFormat='{}{0:dd.MM.yyyy}'}"
                                       FontSize="14"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Button Content="Выйти из аккаунта"
                        Background="#f44336"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,12"
                        CornerRadius="8"
                        Command="{Binding LogoutCommand}"/>
                <Button Content="Тест уведомления"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,12"
                        CornerRadius="8"
                        Command="{Binding TestNotificationCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>