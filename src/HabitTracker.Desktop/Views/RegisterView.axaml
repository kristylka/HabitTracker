<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HabitTracker.Desktop.ViewModels"
             x:Class="HabitTracker.Desktop.Views.RegisterView"
             x:CompileBindings="False">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="32" Width="400">
            <StackPanel Spacing="14">
                <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>

                <TextBlock Text="Регистрация"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2E7D32"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Логин (для входа)"
                               FontSize="12"
                               Foreground="#555555"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Например: liza123"
                             Text="{Binding Username}"
                             CornerRadius="8"
                             Padding="12,10"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Ваше имя"
                               FontSize="12"
                               Foreground="#555555"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Например: Лиза"
                             Text="{Binding DisplayName}"
                             CornerRadius="8"
                             Padding="12,10"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Пароль"
                               FontSize="12"
                               Foreground="#555555"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Минимум 4 символа"
                             PasswordChar="•"
                             Text="{Binding Password}"
                             CornerRadius="8"
                             Padding="12,10"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Подтвердите пароль"
                               FontSize="12"
                               Foreground="#555555"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Повторите пароль"
                             PasswordChar="•"
                             Text="{Binding ConfirmPassword}"
                             CornerRadius="8"
                             Padding="12,10"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#f44336"
                           FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"/>

                <Button Classes="primary"
                        Content="Зарегистрироваться"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding !IsLoading}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="Уже есть аккаунт?"
                               VerticalAlignment="Center"
                               Foreground="Gray"/>
                    <Button Content="Войти"
                            Background="Transparent"
                            Foreground="#2E7D32"
                            FontWeight="SemiBold"
                            Padding="4"
                            Command="{Binding GoToLoginCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>