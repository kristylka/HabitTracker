<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HabitTracker.App.ViewModels"
             x:Class="HabitTracker.App.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="32" Width="400">
            <StackPanel Spacing="16">
                <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>

                <TextBlock Text="Регистрация"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2E7D32"/>

                <TextBox Watermark="Имя пользователя"
                         Text="{Binding Username}"
                         CornerRadius="8"
                         Padding="12,10"/>

                <TextBox Watermark="Отображаемое имя"
                         Text="{Binding DisplayName}"
                         CornerRadius="8"
                         Padding="12,10"/>

                <TextBox Watermark="Пароль"
                         PasswordChar="•"
                         Text="{Binding Password}"
                         CornerRadius="8"
                         Padding="12,10"/>

                <TextBox Watermark="Подтвердите пароль"
                         PasswordChar="•"
                         Text="{Binding ConfirmPassword}"
                         CornerRadius="8"
                         Padding="12,10"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#f44336"
                           FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"/>

                <Button Content="Зарегистрироваться"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="12,10"
                        CornerRadius="8"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding !IsLoading}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="Уже есть аккаунт?"
                               VerticalAlignment="Center"
                               Foreground="Gray"/>
                    <Button Content="Войти"
                            Background="Transparent"
                            Foreground="#2E7D32"
                            FontWeight="SemiBold"
                            Padding="4"
                            Command="{Binding GoToLoginCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>