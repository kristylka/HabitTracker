<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HabitTracker.App.ViewModels"
             x:Class="HabitTracker.App.Views.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">

    <ScrollViewer>
        <StackPanel Margin="32,24" Spacing="20">

            <Border Background="White" CornerRadius="12" Padding="20">
                <DockPanel>
                    <TextBlock Text="Аналитика"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="7 дней"
                                Background="#4CAF50"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,6"
                                Command="{Binding SetPeriodCommand}"
                                CommandParameter="7"/>
                        <Button Content="14 дней"
                                Background="#4CAF50"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,6"
                                Command="{Binding SetPeriodCommand}"
                                CommandParameter="14"/>
                        <Button Content="30 дней"
                                Background="#4CAF50"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,6"
                                Command="{Binding SetPeriodCommand}"
                                CommandParameter="30"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="24">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="Общий процент выполнения"
                               FontSize="16"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OverallCompletionRate, StringFormat='{}{0:F1}%'}"
                               FontSize="56"
                               FontWeight="Bold"
                               Foreground="#2E7D32"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedPeriodDays, StringFormat='за последние {0} дней'}"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="По привычкам"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Нет данных для отображения"
                               Foreground="Gray"
                               FontStyle="Italic"
                               IsVisible="{Binding !HabitStats.Count}"/>

                    <ItemsControl ItemsSource="{Binding HabitStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="16,12"
                                        Margin="0,4"
                                        Background="#FAFAFA">
                                    <StackPanel Spacing="8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding CompletionRate, StringFormat='{}{0:F0}%'}"
                                                       FontWeight="Bold"
                                                       Foreground="#2E7D32"
                                                       FontSize="16"/>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="12"
                                                        Height="12"
                                                        CornerRadius="6"
                                                        Background="{Binding Color}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Height="8"
                                                Background="#E0E0E0"
                                                CornerRadius="4">
                                            <Border Background="{Binding Color}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="4"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock FontSize="12"
                                                       Foreground="Gray">
                                                <Run Text="Серия: "/>
                                                <Run Text="{Binding CurrentStreak}"/>
                                                <Run Text=" дн."/>
                                            </TextBlock>
                                            <TextBlock FontSize="12"
                                                       Foreground="Gray">
                                                <Run Text="Рекорд: "/>
                                                <Run Text="{Binding BestStreak}"/>
                                                <Run Text=" дн."/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Активность по дням"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <ItemsControl ItemsSource="{Binding DailyStats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4" Width="52" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Count}"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#2E7D32"/>
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="8"
                                            Background="#E8F5E9"
                                            Margin="0,4"/>
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM}'}"
                                               HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>